# Environment Variables for LLM Multi-Agent Resume Optimizer

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Atlas
MONGODB_URI=mongodb+srv://lmaro_admin:<password>@lmaro-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lmaro_db

# JWT Secret (generate a strong random string)
SECRET_KEY=your-secret-key-change-this-to-something-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ChromaDB Path (local storage)
CHROMADB_PATH=./chromadb_store

# FastAPI Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (for frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
