# ============================================================
# Document Intelligence Platform - environment variables
# Defaults target AWS production (Bedrock + Titan + OpenSearch + DynamoDB + Redis).
# For local dev without AWS, override the four *_BACKEND vars.
# ============================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ---- Metadata store (default: DynamoDB) ----
METADATA_BACKEND=dynamodb   # dynamodb | mongo
DYNAMODB_TABLE_METADATA=docintel-metadata
DYNAMODB_TABLE_SESSIONS=docintel-sessions
MONGO_URI=mongodb://localhost:27017
MONGO_DB=docintel

# ---- Vector store (default: OpenSearch Serverless) ----
VECTOR_BACKEND=opensearch   # opensearch | chroma | pgvector
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=docintel-vectors
CHROMA_PATH=./chromadb_store
PGVECTOR_DSN=postgresql://user:pass@localhost:5432/docintel

# ---- LLM (default: Bedrock LLaMA 3) ----
LLM_BACKEND=bedrock         # bedrock | gemini
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_REGION=us-east-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings (default: Titan) ----
EMBEDDINGS_BACKEND=titan    # titan | gemini | sentence_transformers
TITAN_MODEL_ID=amazon.titan-embed-text-v1
GEMINI_EMBEDDING_MODEL=text-embedding-004
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ---- Ingestion ----
S3_BUCKET_INGEST=docintel-ingest
SQS_INGEST_QUEUE_URL=
STEP_FUNCTIONS_ARN=
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
KEYWORD_HYBRID_ENABLED=true

# ---- Quality pipeline ----
QUALITY_THRESHOLD=90
MAX_EVAL_ROUNDS=3
MAX_FACTUALITY_ROUNDS=2

# ---- Session (agent WebSocket) ----
SESSION_TIMEOUT_SECONDS=300
QUESTION_TIMEOUT_SECONDS=60

# ---- Caching (default: Redis) ----
CACHE_BACKEND=redis         # redis | memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_EMBEDDING=86400
CACHE_TTL_RETRIEVAL=300
CACHE_TTL_ANSWER=600
CACHE_TTL_METADATA=3600

# ---- Tools (Action Agent) ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SERVICENOW_BASE_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GITHUB_TOKEN=

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=
SECRETS_MANAGER_PREFIX=docintel/

# ---- Observability ----
CLOUDWATCH_LOG_GROUP=/docintel/app
CLOUDWATCH_NAMESPACE=DocIntel
ENABLE_STRUCTURED_LOGS=true
ENABLE_METRICS=true
